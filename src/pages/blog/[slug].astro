---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { SITE_NAME, AUTHOR_NAME } from '../../consts';
import { formatDate, readingTime, shareImage } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, topic, heroImage, heroAlt, sources } = post.data;
const { Content } = await render(post);
const lastUpdated = updatedDate ?? pubDate;
const minutes = readingTime(post.body);
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const siteURL = new URL('/', Astro.site).href;
const ogImage = shareImage(heroImage);

const sourceLinks = sources.map((s) =>
  typeof s === 'string' ? { title: new URL(s).hostname.replace(/^www\./, ''), url: s } : s,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: [new URL(heroImage, Astro.site).href],
  datePublished: pubDate.toISOString(),
  dateModified: lastUpdated.toISOString(),
  inLanguage: 'en-IN',
  articleSection: topic,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@type': 'Person', name: AUTHOR_NAME, url: new URL('/about', Astro.site).href },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteURL}#organization`,
    name: SITE_NAME,
    url: siteURL,
    logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).href },
  },
  citation: sourceLinks.map((s) => s.url),
};
---
<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={heroAlt}
  type="article"
  publishedTime={pubDate}
  modifiedTime={lastUpdated}
  jsonLd={jsonLd}
>
  <article class="container post">
    <header class="post-head">
      <p class="eyebrow"><a href="/blog">Blog</a> · {topic}</p>
      <h1>{title}</h1>
      <p class="meta muted">
        By <a href="/about">{AUTHOR_NAME}</a> ·
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> ·
        {minutes} min read
      </p>
    </header>

    <img class="hero-img" src={heroImage} alt={heroAlt} width="1200" height="675" fetchpriority="high" />

    <div class="prose">
      <Content />
    </div>

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources</h2>
      <ol>
        {sourceLinks.map((s) => (
          <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>
        ))}
      </ol>
    </section>

    <p class="updated muted">
      Last updated: <time datetime={lastUpdated.toISOString()}>{formatDate(lastUpdated)}</time>
    </p>

    <div class="post-newsletter">
      <NewsletterForm />
    </div>
  </article>
</BaseLayout>

<style>
  .post-head { padding: 3rem 0 1.5rem; }
  .post-head .eyebrow a { color: inherit; text-decoration: none; }
  .meta { font-size: 0.95rem; margin: 0; }
  .meta a { color: var(--text); }
  .hero-img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--border); background: var(--bg-raised); }
  .sources { margin-top: 3rem; border-top: 1px solid var(--border); }
  .sources ol { padding-left: 1.25rem; }
  .sources li { margin: 0.35rem 0; word-break: break-word; }
  .updated { font-size: 0.95rem; margin-top: 1.5rem; }
  .post-newsletter { margin-top: 3rem; }

  /* Markdown content */
  .prose { margin-top: 2rem; font-size: 1.1rem; }
  .prose :global(p) { margin: 0 0 1.1rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; margin: 0 0 1.1rem; }
  .prose :global(li) { margin: 0.35rem 0; }
  .prose :global(strong) { color: #fff; }
  .prose :global(img) { border-radius: var(--radius); margin: 1.5rem 0; }

  /* 1) The first paragraph is the 2-sentence answer */
  .prose > :global(p:first-child) {
    font-size: 1.2rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem;
  }
  .prose > :global(p:first-child)::before {
    content: 'The short answer';
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  /* 2) A blockquote (> ...) becomes the "Mind-blowing fact" box */
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.4rem;
    background: rgba(255, 180, 84, 0.1);
    border: 1px solid rgba(255, 180, 84, 0.45);
    border-left: 5px solid var(--accent);
    border-radius: var(--radius);
  }
  .prose :global(blockquote)::before {
    content: '✦ Mind-blowing fact';
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }

  /* 3) FAQ questions (### headings) */
  .prose :global(h3) { color: var(--text); }
</style>
