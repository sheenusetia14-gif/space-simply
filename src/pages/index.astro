---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_DESCRIPTION, AUTHOR_NAME } from '../consts';
import { sortPosts } from '../utils';

const latest = sortPosts(await getCollection('blog')).slice(0, 6);

const topics = ['Black holes', 'Planets', 'The Moon', 'The Sun', 'Space missions'];

const reasons = [
  { icon: 'chat', title: 'Plain language', text: 'No jargon or formulas. If a word needs explaining, we explain it.' },
  { icon: 'clock', title: '3-minute reads', text: 'One big idea per post, short enough for a chai break.' },
  { icon: 'check', title: 'Trusted sources', text: 'Every fact is checked against NASA, ESA and ISRO.' },
];
const siteURL = new URL('/', Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteURL}#organization`,
    name: SITE_NAME,
    url: siteURL,
    logo: new URL('/favicon.svg', Astro.site).href,
    slogan: SITE_TAGLINE,
    description: SITE_DESCRIPTION,
    founder: { '@type': 'Person', name: AUTHOR_NAME },
    areaServed: 'IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: siteURL,
    inLanguage: 'en-IN',
    publisher: { '@id': `${siteURL}#organization` },
  },
];
---
<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Space, Simply</p>
      <h1>{SITE_TAGLINE}</h1>
      <p class="intro">
        Black holes, exploding stars, planets made of diamonds — space is wilder than any film.
        Each post here explains one big idea in plain, everyday language. No science degree
        needed, no formulas, just a cup of chai and three minutes.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/blog">Start reading</a>
        <a class="text-link" href="#newsletter">Get a fact every Friday →</a>
      </div>
    </div>
  </section>

  <section class="container-wide spotlight-wrap" aria-labelledby="fact-title">
    <div class="spotlight">
      <img src="/images/facts/venus.svg" alt="Illustration of Venus, a pale yellow planet, with an arrow showing its slow spin." width="400" height="400" loading="lazy" decoding="async" />
      <div class="spotlight-body">
        <p class="eyebrow">✦ Mind-blowing fact</p>
        <h2 id="fact-title">A day on Venus is longer than its year.</h2>
        <p class="muted">
          Venus spins so slowly that one full turn takes about 243 Earth days.
          But it goes around the Sun in just 225 days, so a single day outlasts a whole year.
        </p>
        <p class="source">Source: <a href="https://science.nasa.gov/venus/venus-facts/" rel="noopener" target="_blank">NASA Science — Venus facts</a></p>
      </div>
    </div>
  </section>

  <section class="container-wide latest" aria-labelledby="latest-title">
    <div class="section-head">
      <h2 id="latest-title">Latest explainers</h2>
      <a href="/blog">See all posts →</a>
    </div>
    <div class="grid">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="container-wide topics" aria-labelledby="topics-title">
    <h2 id="topics-title">Explore by topic</h2>
    <ul class="topic-list">
      {topics.map((topic) => <li>{topic}</li>)}
    </ul>
  </section>

  <section class="container-wide why" aria-labelledby="why-title">
    <h2 id="why-title">Why Space, Simply</h2>
    <ul class="why-list">
      {reasons.map((r) => (
        <li>
          <span class="why-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {r.icon === 'chat' && <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />}
              {r.icon === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
              {r.icon === 'check' && <><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" /><path d="M9 12l2 2 4-4" /></>}
            </svg>
          </span>
          <p><strong>{r.title}.</strong> <span class="muted">{r.text}</span></p>
        </li>
      ))}
    </ul>
  </section>

  <div class="container newsletter-wrap">
    <NewsletterForm />
  </div>
</BaseLayout>

<style>
  .hero { padding: 3.5rem 0 2.5rem; text-align: left; }
  .hero h1 { margin-top: 0.5rem; }
  .intro { font-size: 1.15rem; color: var(--text-muted); max-width: 38rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 1.75rem; }
  .text-link { font-weight: 600; text-decoration: none; }
  .spotlight-wrap { margin-top: 1rem; }
  .spotlight {
    display: grid; gap: 1.25rem; align-items: center;
    background: linear-gradient(160deg, var(--bg-raised-2), var(--bg-raised));
    border: 1px solid rgba(255, 180, 84, 0.45);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .spotlight img { width: 160px; margin: 0 auto; }
  .spotlight h2 { margin: 0.35rem 0 0.6rem; font-size: clamp(1.5rem, 4.5vw, 2.1rem); }
  .spotlight .muted { margin: 0 0 0.9rem; max-width: 36rem; }
  .source { margin: 0; font-size: 0.9rem; color: var(--text-muted); }
  .latest { margin-top: 3rem; }
  .topics, .why { margin-top: 3.5rem; }
  .topics h2, .why h2 { margin: 0 0 1rem; }
  .topic-list { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; padding: 0; }
  .topic-list li {
    border: 1px solid var(--border); background: var(--bg-raised);
    border-radius: 999px; padding: 0.45rem 1rem; font-size: 0.95rem; font-weight: 500;
  }
  .why-list { list-style: none; display: grid; gap: 1rem; margin: 0; padding: 0; }
  .why-list li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .why-list p { margin: 0.1rem 0 0; }
  .why-icon {
    flex: none; display: inline-grid; place-items: center; width: 40px; height: 40px;
    border-radius: 50%; background: rgba(255, 180, 84, 0.12); color: var(--accent);
  }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .section-head h2 { margin: 1rem 0; }
  .section-head a { font-weight: 600; text-decoration: none; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  .newsletter-wrap { margin-top: 3.5rem; }
  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .hero { padding: 5rem 0 3rem; }
    .spotlight { grid-template-columns: 200px 1fr; padding: 2rem 2.25rem; gap: 2rem; }
    .spotlight img { width: 200px; }
  }
  @media (min-width: 960px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .why-list { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }
</style>
