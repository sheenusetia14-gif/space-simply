---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, topic, heroImage, heroAlt } = post.data;
---
<article class="card">
  <a href={`/blog/${post.id}`} class="card-link">
    <img src={heroImage} alt={heroAlt} width="640" height="360" loading="lazy" decoding="async" />
    <div class="card-body">
      <span class="eyebrow">{topic}</span>
      <h3>{title}</h3>
      <p class="muted">{description}</p>
      <p class="meta"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post.body)} min read</p>
    </div>
  </a>
</article>

<style>
  .card { background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: border-color 0.15s; }
  .card:hover { border-color: var(--accent); }
  .card-link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  img { aspect-ratio: 16 / 9; width: 100%; object-fit: cover; background: var(--bg-raised-2); }
  .card-body { padding: 1.1rem 1.25rem 1.3rem; }
  h3 { margin: 0.35rem 0 0.4rem; font-size: 1.2rem; }
  p { margin: 0; font-size: 0.97rem; line-height: 1.55; }
  .meta { margin-top: 0.75rem; font-size: 0.85rem; color: var(--text-muted); }
</style>
